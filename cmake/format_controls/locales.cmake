# Exercise the production compiler wrapper, not just canned diagnostic text.
# The non-English locale need not be installed: controls must always compile
# under C. Check restoration after both successful and rejected compilations.
if(DEFINED ENV{LC_ALL})
    set(locale_test_had_lc_all TRUE)
    set(locale_test_saved_lc_all "$ENV{LC_ALL}")
else()
    set(locale_test_had_lc_all FALSE)
endif()
foreach(locale_case IN ITEMS unset non_english)
    set(control safe)
    if(locale_case STREQUAL "unset")
        unset(ENV{LC_ALL})
    else()
        set(ENV{LC_ALL} "fr_FR.UTF-8")
        set(control unsafe)
    endif()
    eqemu_compile_format_control("${control}"
        "${control_root}/locale-${locale_case}" compiled output)
    file(WRITE "${control_root}/locale-${locale_case}.log" "${output}")
    if(locale_case STREQUAL "unset")
        if(DEFINED ENV{LC_ALL})
            message(FATAL_ERROR "Format gate locale regression: LC_ALL was not unset again")
        endif()
    elseif(NOT "$ENV{LC_ALL}" STREQUAL "fr_FR.UTF-8")
        message(FATAL_ERROR "Format gate locale regression: non-English LC_ALL was not restored")
    endif()
    if(control STREQUAL "safe")
        if(NOT compiled)
            message(FATAL_ERROR "Format gate locale regression (${locale_case}): safe control failed:\n${output}")
        endif()
    else()
        eqemu_format_control_rejected("${compiled}" "${output}" rejected)
        if(NOT rejected)
            message(FATAL_ERROR "Format gate locale regression: expected English int/double rejection:\n${output}")
        endif()
    endif()
endforeach()
if(locale_test_had_lc_all)
    set(ENV{LC_ALL} "${locale_test_saved_lc_all}")
else()
    unset(ENV{LC_ALL})
endif()
message(STATUS "Format gate: locale compilation/restoration controls passed (unset, non-English)")
